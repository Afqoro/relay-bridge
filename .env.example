# relay-bridge configuration
# Copy to .env and export, or set these in ecosystem.config.js (pm2).

# ---- Relay pool type: vercel | cloudflare | all (hybrid) ----
RELAY_TYPE=vercel

# Comma-separated relay base URLs for the selected type.
RELAY_VERCEL=https://relay-deployer-santo-4xl0o68gv-santonijaya8-4344s-projects.vercel.app,https://relay-deployer-auah-fp850hnlh-auah-s-projects.vercel.app,https://relay-deployer-sengkyou-egw1q82ao-goodboyguds-projects.vercel.app

RELAY_CLOUDFLARE=https://aurora8456-inbox-nullpter-web-id.a8310d927dc.workers.dev,https://caleb05-student-nullpter-web-id.a746906ca1e.workers.dev,https://salma31-teach-nullpter-web-id.aebd1a703c8.workers.dev

# Optional secret (x-relay-secret); empty = none.
RELAY_SECRET=

# Routing mode: round_robin (default) | fallback (active-backup)
RELAY_MODE=round_robin

